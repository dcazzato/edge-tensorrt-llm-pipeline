# Template for the multimodal (VLM) layer — copy to .env and fill in.
#   cp .env.example .env
# Start the API reading it with:
#   uv run uvicorn edge_trt_llm.api.app:app --env-file .env
#
# SECURITY: .env is gitignored (see .gitignore) — NEVER put real keys in
# committed files. This template ships placeholders only.
#
# No VLM_BASE_URL -> /detect still works; /describe answers vlm_status="disabled".

# Any OpenAI-compatible /chat/completions endpoint:
#   OpenRouter  https://openrouter.ai/api/v1
#   OpenAI      https://api.openai.com/v1
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
VLM_BASE_URL=https://openrouter.ai/api/v1

# Must be a VISION model, in the provider's own slug format.
VLM_MODEL=openai/gpt-4o-mini

# Optional: falls back to OPENAI_API_KEY, then to "not-needed" (Ollama etc.).
VLM_API_KEY=sk-or-v1-your-key-here

# Optional: request timeout in seconds (default 60).
#VLM_TIMEOUT_S=60
